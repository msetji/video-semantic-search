# Copy this file to `backend/.env` and uncomment or edit values as needed.
# Settings load `.env` from the process working directory: start uvicorn from
# `backend/` (see SETUP.md) so these variables apply.

# Hugging Face model id for CLIP (image + text encoder)
CLIP_MODEL_ID=openai/clip-vit-base-patch32

# Cap sampled frames per MP4 at ~1 FPS (default 7200 ≈ 2 hours)
# MAX_FRAMES_PER_VIDEO=7200

# Optional absolute paths (defaults point under the repo root)
# MEDIA_ROOT=C:\path\to\default\media
# FAISS_INDEX_PATH=C:\path\to\faiss.index
# SQLITE_METADATA_PATH=C:\path\to\metadata.sqlite
# LEGACY_METADATA_JSON_PATH=C:\path\to\metadata.json
